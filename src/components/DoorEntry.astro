---
interface Props {
  image: string;
}

const { image } = Astro.props;
---

<section class="entry-portal" data-entry-portal aria-labelledby="entry-title">
  <h1 id="entry-title" class="visually-hidden">
    Sirpi Interiors — step into living heritage
  </h1>
  <div class="entry-portal-stage">
    <div class="entry-portal-frame">
      <img
        class="entry-portal-image"
        src={image}
        width="1536"
        height="1024"
        fetchpriority="high"
        alt="Original concept of a warm South Indian heritage living room"
      />
      <span class="entry-shutter entry-shutter-start" aria-hidden="true"></span>
      <span class="entry-shutter entry-shutter-end" aria-hidden="true"></span>
      <div class="entry-portal-scrim" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const portal = document.querySelector<HTMLElement>('[data-entry-portal]');

  if (portal && !reducedMotion.matches) {
    document.documentElement.dataset.entryReady = '';
    document.documentElement.dataset.entryStarting = '';
    document.documentElement.dataset.entryImmersive = '';
    let framePending = false;

    const smoothstep = (start: number, end: number, value: number) => {
      const amount = Math.min(1, Math.max(0, (value - start) / (end - start)));
      return amount * amount * (3 - 2 * amount);
    };

    const updateEntry = () => {
      const rect = portal.getBoundingClientRect();
      const distance = Math.max(1, portal.offsetHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, -rect.top / distance));
      const doorProgress = smoothstep(0.04, 0.68, progress);
      const cameraProgress = smoothstep(0, 1, progress);
      const handoffProgress = smoothstep(0.78, 1, progress);
      portal.style.setProperty('--entry-progress', progress.toFixed(4));
      portal.style.setProperty('--door-progress', doorProgress.toFixed(4));
      portal.style.setProperty('--camera-progress', cameraProgress.toFixed(4));
      portal.style.setProperty(
        '--handoff-progress',
        handoffProgress.toFixed(4),
      );
      document.documentElement.toggleAttribute(
        'data-entry-starting',
        progress < 0.025,
      );
      document.documentElement.toggleAttribute(
        'data-entry-immersive',
        progress < 0.985,
      );
      framePending = false;
    };

    const requestUpdate = () => {
      if (framePending) return;
      framePending = true;
      requestAnimationFrame(updateEntry);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    updateEntry();
  }
</script>
